{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [
    { "column": 100, "color": "#500" },
    { "column": 120, "color": "#800" }
  ],
  "[typescript]": {
    "editor.rulers": [{ "column": 120, "color": "#800" }]
  },
  "[typescriptreact]": {
    "editor.rulers": [{ "column": 120, "color": "#800" }]
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[shellscript]": {
    "files.eol": "\n",
    "files.encoding": "utf8"
  }
}
