# Public local PoC defaults. Credentials are intentionally known. Bind services to loopback.
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# formiq PoC QA | four infrastructure services plus Web and two workers
# These fixed credentials are public local PoC values; external API keys are supplied at runtime.

# ===[GENERAL]======================================================================================
ENV_MODE=qa
STACK_NAME=formiqpoc
INSTANCE_INDEX=0
TZ=Europe/Warsaw
NODE_IMAGE=node:26.12.1-bookworm-slim
# ---[LOGGING]--------------------------------------------------------------------------------------
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILE=3

# ===[APPLICATION]==================================================================================
APP_HOST=127.0.0.1
WEB_HOST=127.0.0.1
# Shared QA Compose retains this variable name; PoC serves plain HTTP on this port.
WEB_HTTPS_PORT=4100
APP_PUBLIC_URL=http://127.0.0.1:4100

# ===[DATABASE]=====================================================================================
DB_IMAGE=postgres:18.6-bookworm
DB_VOLUME_NAME=formiqpoc-postgres
DB_PORT=25433
DB_MAX_CONNECTIONS=100
DB_SHM_SIZE=128m
DB_INIT_ARGS=--encoding=UTF8 --locale=C.UTF-8 --auth-host=scram-sha-256
DB_ADMIN_USERNAME=formiq_admin
DB_ADMIN_PASSWORD=poc-local-db-admin-password-2026-formiq
DB_APP_DATABASE_NAME=formiq
DB_APP_USERNAME=formiq_app
DB_APP_PASSWORD=poc-local-db-app-password-2026-formiq
DB_APP_CONNECTION_LIMIT=40
DB_AUTH_DATABASE_NAME=keycloak
DB_AUTH_USERNAME=formiq_keycloak
DB_AUTH_PASSWORD=poc-local-db-auth-password-2026-formiq
DB_AUTH_CONNECTION_LIMIT=20
DB_QUEUE_DATABASE_NAME=formiq_queue
DB_QUEUE_USERNAME=formiq_queue
DB_QUEUE_PASSWORD=poc-local-db-queue-password-2026-formiq
DB_QUEUE_CONNECTION_LIMIT=12
# ---[LIMITS]---------------------------------------------------------------------------------------
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g

# ===[AUTHENTICATION]===============================================================================
AUTH_BASE_IMAGE=quay.io/keycloak/keycloak:26.7.5
AUTH_IMAGE=formiq-keycloak:26.7.5-postgres-qa
AUTH_HOST=127.0.0.1
AUTH_ADMIN_HOST=127.0.0.1
AUTH_PUBLIC_URL=http://127.0.0.1:10800
AUTH_ADMIN_PUBLIC_URL=http://127.0.0.1:10800
AUTH_LOCAL_PORT=10800
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin
KEYCLOAK_WEB_CLIENT_SECRET=poc-local-keycloak-web-client-secret-2026-formiq
AUTH_DIRECTORY_CLIENT_SECRET=poc-local-auth-directory-client-secret-2026-formiq
AUTH_SESSION_IDLE_SECONDS=2700
AUTH_SESSION_MAX_SECONDS=28800
AUTH_THEME_COOKIE_NAME=formiq_qa_theme
AUTH_DB_POOL_INITIAL_SIZE=1
AUTH_DB_POOL_MIN_SIZE=1
AUTH_DB_POOL_MAX_SIZE=15
AUTH_HTTP_ENABLED=true
AUTH_HOSTNAME_STRICT=true
AUTH_HOSTNAME_DEBUG=false
# ---[LIMITS]---------------------------------------------------------------------------------------
AUTH_CPU_LIMIT=2.0
AUTH_MEMORY_LIMIT=1g

# ===[STORAGE]======================================================================================
S3_IMAGE=formiq-seaweedfs:4.51-qa
S3_BASE_IMAGE=chrislusf/seaweedfs:4.51
S3_VOLUME_NAME=formiqpoc-seaweedfs
S3_HOST=127.0.0.1
S3_PORT=28333
S3_REGION=eu-central-1
S3_BUCKET=formiq-documents
S3_ADMIN_ACCESS_KEY=formiq-qa-admin # <<< [!]
S3_ADMIN_SECRET_KEY=poc-local-s3-admin-secret-key-2026-formiq
S3_APP_ACCESS_KEY=formiq-qa-app # <<< [!]
S3_APP_SECRET_KEY=poc-local-s3-app-secret-key-2026-formiq
# ---[LIMITS]---------------------------------------------------------------------------------------
S3_CPU_LIMIT=1.0
S3_MEMORY_LIMIT=1g
# ---[AVATARS]--------------------------------------------------------------------------------------
S3_AVATAR_BUCKET=formiqpoc-keycloak
S3_AVATAR_ACCESS_KEY=formiq-qa-avatar
S3_AVATAR_SECRET_KEY=poc-local-s3-avatar-secret-key-2026-formiq
# ---[CONSOLE]--------------------------------------------------------------------------------------
S3CONSOLE_IMAGE=chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8
S3CONSOLE_HOST=127.0.0.1
S3CONSOLE_PORT=28090
S3CONSOLE_ADMIN_USERNAME=admin
S3CONSOLE_ADMIN_PASSWORD=poc-local-s3console-admin-password-2026-formiq
S3CONSOLE_CPU_LIMIT=0.5
S3CONSOLE_MEMORY_LIMIT=128m

# ---[LIMITS]---------------------------------------------------------------------------------------

# ===[UI PREFERENCES]===============================================================================
UI_PREFERENCE_COOKIE_DOMAIN=

# ===[WEB - NEXT.JS]================================================================================
# Multi-stage build: apps/web/Dockerfile, target web (standalone production runtime).
WEB_IMAGE=formiq-web:poc
WEB_APP_NAME=FORMIQ QA

WEB_LANGUAGE_COOKIE_NAME=formiq_qa_locale
WEB_THEME_COOKIE_NAME=formiq_qa_theme
WEB_CONTRAST_COOKIE_NAME=formiq_qa_contrast
# ---[AUTHENTICATION]-------------------------------------------------------------------------------
AUTH_SECRET=poc-local-auth-secret-2026-formiq
AUTH_COOKIE_PREFIX=formiq_qa_auth
# ---[SESSION POLICY]-------------------------------------------------------------------------------
SESSION_TTL=2700
SESSION_WARNING=120
SESSION_AUTO_REFRESH=false
SESSION_MAX_REFRESHES=3
# ---[LIMITS]---------------------------------------------------------------------------------------
WEB_CPU_LIMIT=1.0
WEB_MEMORY_LIMIT=512m

# ===[QUEUE WORKER]=================================================================================
# Multi-stage build: apps/web/Dockerfile, target queue (production dependencies only).
QUEUE_IMAGE=formiq-queue:poc
# ---[LIMITS]---------------------------------------------------------------------------------------
QUEUE_CPU_LIMIT=1.0
QUEUE_MEMORY_LIMIT=384m

# ===[PYTHON WORKER]================================================================================
# Multi-stage build: apps/pyworker/Dockerfile, target runtime (hash-verified runtime wheels).
PYWORKER_IMAGE=formiq-pyworker:poc
PYTHON_IMAGE=python:3.14.7-slim-bookworm
PYWORKER_FORMS_TOKEN=poc-local-pyworker-forms-token-2026-formiq
PYWORKER_API_TOKEN=poc-local-pyworker-api-token-2026-formiq
# ---[RUNTIME]--------------------------------------------------------------------------------------
PYWORKER_MAX_CONCURRENCY=4
PYWORKER_TASK_TIMEOUT_SECONDS=5
PYWORKER_LOG_LEVEL=info
# ---[LIMITS]---------------------------------------------------------------------------------------
PYWORKER_CPU_LIMIT=4.0
PYWORKER_MEMORY_LIMIT=8g

# ===[DATABASE MAINTENANCE]=========================================================================
# Multi-stage build: apps/web/Dockerfile, target maintenance; one-off migration/seed operations.
MAINTENANCE_IMAGE=formiq-maintenance:poc

# Stable persistent storage identity; independent of container names
S3CONSOLE_VOLUME_NAME=formiqpoc-s3console

POC_ADMIN_PASSWORD=admin
POC_USER_PASSWORD=user
PYWORKER_FORM_MODE=agentcore
PYWORKER_HARNESS_EXPIRES_AT=2026-11-22T19:09:47.576880+00:00
EDENAI_TIMEOUT_SECONDS=300
EDENAI_MAX_INPUT_CHARS=200000
EDENAI_MAX_OUTPUT_TOKENS=24576
EDENAI_VISION_MODEL=qwen3.8-27b

# Container-only database URLs derived from the public PoC defaults.
QA_DATABASE_URL=postgresql://${DB_APP_USERNAME}:${DB_APP_PASSWORD}@db:5432/${DB_APP_DATABASE_NAME}?schema=public
QA_QUEUE_DATABASE_URL=postgresql://${DB_QUEUE_USERNAME}:${DB_QUEUE_PASSWORD}@db:5432/${DB_QUEUE_DATABASE_NAME}
