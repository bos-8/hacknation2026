{
  "name": "@formiq/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": null,
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/worker.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg-boss": "12.38.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8",
    "typescript": "5.9.3"
  }
}
