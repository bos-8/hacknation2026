# @file: packages/database/.env.example
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# ===[DATABASE - PRISMA CLI]========================================================================
# Prisma CLI only. Use the application database owner for DEV migrations.
# Replace credentials with infra/local/.env.dev values; URL-encode special characters.
DATABASE_URL=postgresql://formiq_app:CHANGE_ME@127.0.0.1:5432/formiq?schema=public # <<< [!]

# ---[SHADOW DATABASE]------------------------------------------------------------------------------
# DEV migration tooling only: an isolated disposable database, never app/auth/queue.
SHADOW_DATABASE_URL= # <<< [!]
