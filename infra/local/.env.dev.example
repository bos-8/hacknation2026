# @file: infra/local/.env.dev.example
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# formiq PoC DEV | four infrastructure services
# Private values belong only in ignored env files.

# ===[GENERAL]======================================================================================
ENV_MODE=dev
STACK_NAME=formiqdev
INSTANCE_INDEX=0
TZ=Europe/Warsaw
NODE_IMAGE=node:26.12.1-bookworm-slim
# ---[LOGGING]--------------------------------------------------------------------------------------
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILE=3

# ===[TLS/SSL]======================================================================================
CERTS_DIR=./certs
TLS_CERT_PEM=localhost.pem
TLS_CERT_KEY=localhost-key.pem
TLS_CA_PEM=rootCA.pem

# ===[APPLICATION]==================================================================================
APP_HOST=localhost
WEB_HOST=localhost
WEB_HTTPS_PORT=3000
APP_PUBLIC_URL=https://localhost:3000

# ===[DATABASE]=====================================================================================
DB_IMAGE=postgres:18.6-bookworm
DB_VOLUME_NAME=formiqdev-postgres
DB_PORT=5432
DB_MAX_CONNECTIONS=100
DB_SHM_SIZE=128m
DB_INIT_ARGS=--encoding=UTF8 --locale=C.UTF-8 --auth-host=scram-sha-256
DB_ADMIN_USERNAME=formiq_admin
DB_ADMIN_PASSWORD=CHANGE_ME # <<< [!]
DB_APP_DATABASE_NAME=formiq
DB_APP_USERNAME=formiq_app
DB_APP_PASSWORD=CHANGE_ME # <<< [!]
DB_APP_CONNECTION_LIMIT=40
DB_AUTH_DATABASE_NAME=keycloak
DB_AUTH_USERNAME=formiq_keycloak
DB_AUTH_PASSWORD=CHANGE_ME # <<< [!]
DB_AUTH_CONNECTION_LIMIT=20
DB_QUEUE_DATABASE_NAME=formiq_queue
DB_QUEUE_USERNAME=formiq_queue
DB_QUEUE_PASSWORD=CHANGE_ME # <<< [!]
DB_QUEUE_CONNECTION_LIMIT=12
# ---[LIMITS]---------------------------------------------------------------------------------------
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g

# ===[AUTHENTICATION]===============================================================================
AUTH_BASE_IMAGE=quay.io/keycloak/keycloak:26.7.5
AUTH_IMAGE=formiq-keycloak:26.7.5-postgres
AUTH_HOST=localhost
AUTH_ADMIN_HOST=localhost
AUTH_PUBLIC_URL=https://localhost:8443
AUTH_ADMIN_PUBLIC_URL=https://localhost:8443
AUTH_LOCAL_PORT=8443
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=CHANGE_ME # <<< [!]
KEYCLOAK_WEB_CLIENT_SECRET=CHANGE_ME # <<< [!]
AUTH_DIRECTORY_CLIENT_SECRET=CHANGE_ME # <<< [!]
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_MAX_SECONDS=28800
AUTH_THEME_COOKIE_NAME=formiq_theme
AUTH_DB_POOL_INITIAL_SIZE=1
AUTH_DB_POOL_MIN_SIZE=1
AUTH_DB_POOL_MAX_SIZE=15
AUTH_HTTP_ENABLED=true
AUTH_HOSTNAME_STRICT=true
AUTH_HOSTNAME_DEBUG=false
# ---[LIMITS]---------------------------------------------------------------------------------------
AUTH_CPU_LIMIT=2.0
AUTH_MEMORY_LIMIT=1g

# ===[STORAGE]======================================================================================
S3_IMAGE=formiq-seaweedfs:4.51
S3_BASE_IMAGE=chrislusf/seaweedfs:4.51
S3_VOLUME_NAME=formiqdev-seaweedfs
S3_HOST=localhost
S3_PORT=8333
S3_REGION=eu-central-1
S3_BUCKET=formiq-documents
S3_ADMIN_ACCESS_KEY=formiq-dev-admin # <<< [!]
S3_ADMIN_SECRET_KEY=CHANGE_ME # <<< [!]
S3_APP_ACCESS_KEY=formiq-dev-app # <<< [!]
S3_APP_SECRET_KEY=CHANGE_ME # <<< [!]
# ---[LIMITS]---------------------------------------------------------------------------------------
S3_CPU_LIMIT=1.0
S3_MEMORY_LIMIT=1g
# ---[AVATARS]--------------------------------------------------------------------------------------
S3_AVATAR_BUCKET=formiq-keycloak
S3_AVATAR_ACCESS_KEY=formiq-dev-avatar
S3_AVATAR_SECRET_KEY=CHANGE_ME
# ---[CONSOLE]--------------------------------------------------------------------------------------
S3CONSOLE_IMAGE=chrislusf/seaweedfs:4.51
S3CONSOLE_HOST=localhost
S3CONSOLE_PORT=8090
S3CONSOLE_ADMIN_USERNAME=admin
S3CONSOLE_ADMIN_PASSWORD=CHANGE_ME # <<< [!]
S3CONSOLE_CPU_LIMIT=0.5
S3CONSOLE_MEMORY_LIMIT=128m

# ---[LIMITS]---------------------------------------------------------------------------------------

# ===[UI PREFERENCES]===============================================================================
UI_PREFERENCE_COOKIE_DOMAIN=

# Stable persistent storage identity; independent of container names
S3CONSOLE_VOLUME_NAME=formiqdev-s3console

# Local DEV accounts are created on startup (admin/admin and user/user).
# Optional password overrides for NEW accounts; existing passwords are preserved.
# DEV_SEED_ADMIN_PASSWORD=
# DEV_SEED_USER_PASSWORD=
