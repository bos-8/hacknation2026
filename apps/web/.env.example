# @file: apps/web/.env.example
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# ===[GENERAL]======================================================================================
APP_NAME=FORMIQ
APP_COMPANY_NAME=BOSIT
PORT=3000
TZ=Europe/Warsaw

# ---[UI PREFERENCES]-------------------------------------------------------------------------------
LANGUAGE_COOKIE_NAME=formiq_locale
THEME_COOKIE_NAME=formiq_theme
CONTRAST_COOKIE_NAME=formiq_contrast
UI_PREFERENCE_COOKIE_DOMAIN=

# ===[DATABASE]=====================================================================================
# Server-only application DB; DEV uses the host port, QA/PROD use private service DNS.
DATABASE_URL=postgresql://formiq_app:CHANGE_ME@127.0.0.1:5432/formiq?schema=public # <<< [!]

# ---[QUEUE]----------------------------------------------------------------------------------------
# Server-only queue DB; provision locally with pnpm queue:setup.
QUEUE_DATABASE_URL=postgresql://formiq_queue:CHANGE_ME@127.0.0.1:5432/formiq_queue # <<< [!]

# ===[AUTHENTICATION]===============================================================================
# Server-only Better Auth / Keycloak. Use the canonical HTTPS application origin.
AUTH_BASE_URL=https://localhost:3000
AUTH_SECRET=CHANGE_ME # Local DEV example only; replace before deployment.
AUTH_ISSUER=https://localhost:8443/realms/FORMIQ
AUTH_CLIENT_ID=formiq-web
AUTH_CLIENT_SECRET=CHANGE_ME # <<< [!]
AUTH_DIRECTORY_URL=https://localhost:8443/admin/realms/FORMIQ
AUTH_DIRECTORY_CLIENT_ID=formiq-directory
AUTH_DIRECTORY_CLIENT_SECRET=CHANGE_ME # <<< [!]
AUTH_COOKIE_PREFIX=formiq_auth

# ---[SESSION POLICY]-------------------------------------------------------------------------------
# Session values are in seconds. WARNING must be smaller than TTL.
SESSION_TTL=900
SESSION_WARNING=120
# true: navigation between pages renews the session (home /, /pl, /en excluded).
# For this mode use a short TTL, e.g. 900 seconds (15 minutes).
# false: navigation never renews; explicit renewal is available only during warning.
# Background verification every 10 seconds never renews the session in either mode.
SESSION_AUTO_REFRESH=false
# Shared server-side limit for manual AND navigation renewals across all tabs; 0 disables renewals.
SESSION_MAX_REFRESHES=3

# ===[STORAGE]======================================================================================
# ---[AVATARS]--------------------------------------------------------------------------------------
# Dedicated private storage for Keycloak profile pictures.
S3_AVATAR_ENDPOINT=http://127.0.0.1:8333
S3_AVATAR_REGION=eu-central-1
S3_AVATAR_BUCKET=formiq-keycloak
S3_AVATAR_ACCESS_KEY=formiq-dev-avatar # <<< [!]
S3_AVATAR_SECRET_KEY=CHANGE_ME

# ---[DOCUMENTS]------------------------------------------------------------------------------------
# Document bucket used by Administration > Files
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-central-1
S3_BUCKET=formiq-documents
S3_APP_ACCESS_KEY=formiq-dev-app # <<< [!]
S3_APP_SECRET_KEY=CHANGE_ME

# ===[PYTHON WORKER]================================================================================
# Local Python readiness probe. Set empty only when the optional worker is disabled.
MONITOR_PYWORKER_URL=http://127.0.0.1:8010/health/ready
PYWORKER_URL=http://127.0.0.1:8010
PYWORKER_API_TOKEN=CHANGE_ME # <<< [!]

# ---[QUEUE BRIDGE]---------------------------------------------------------------------------------
# Loopback-only Node queue bridge. Clear both fields to disable it.
# Illustrative shared token meets the 32-character minimum; use a private token outside local examples.
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_BRIDGE_PORT=
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_TOKEN=

# ===[MONITORING]===================================================================================
# Healthy responses slower than this become degraded (100-5000 ms).
MONITORING_SLOW_MS=1500

# OpenAI chat (server only). Set a key and the model IDs for the two response modes.
OPENAI_API_KEY=
OPENAI_MODEL_INSTANT=
OPENAI_MODEL_THINKING=

PYWORKER_QUEUE_BRIDGE_PORT=8011
PYWORKER_QUEUE_TOKEN=CHANGE_ME
