# @file: apps/pyworker/.env.example
# @warning: DO NOT USE WEAK SECRETS IN PRODUCTION !!!

# ===[PYTHON WORKER]================================================================================
PYWORKER_HOST=127.0.0.1
PYWORKER_PORT=8010

# ---[AUTHENTICATION]-------------------------------------------------------------------------------
# Generated by pnpm pyworker:setup; server-only, never committed.
PYWORKER_API_TOKEN=CHANGE_ME # <<< [!]

# ---[RUNTIME]--------------------------------------------------------------------------------------
PYWORKER_MAX_CONCURRENCY=4
PYWORKER_TASK_TIMEOUT_SECONDS=5
PYWORKER_LOG_LEVEL=info

# ===[DATABASE]=====================================================================================
# Optional, explicit PostgreSQL access. Disabled until a dedicated least-privilege account is provisioned.
# Remote PostgreSQL requires sslmode=verify-full; never use the Prisma ?schema= URL.
PYWORKER_DATABASE_URL= # <<< [!]

# ===[QUEUE BRIDGE]=================================================================================
# Optional Node queue bridge. Both sides need the same separate private token.
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_URL=
# Optional bridge disabled. Generate a separate random secret before enabling.
# PYWORKER_QUEUE_TOKEN=

PYWORKER_QUEUE_URL=http://127.0.0.1:8011
PYWORKER_QUEUE_TOKEN=CHANGE_ME


# Eden AI form conversion. Set the private API key locally.
# vision = inspect page images with Qwen-VL; ocr = text extraction; eden = OCR/text plus LLM
PYWORKER_FORM_MODE=vision
EDENAI_VISION_MODEL=qwen3.8-27b
EDENAI_API_KEY=
EDENAI_UPLOAD_URL=https://api.edenai.run/v3/upload
EDENAI_LLM_URL=https://api.edenai.run/v3/chat/completions
EDENAI_LLM_MODEL=qwen3.8-27b

# Total time budget for Eden upload, OCR and LLM in seconds (1-300).
EDENAI_TIMEOUT_SECONDS=300
EDENAI_MAX_INPUT_CHARS=200000
EDENAI_MAX_OUTPUT_TOKENS=24576

# Optional local Chat Completions on loopback. Leave URL empty until Qwen is running.
PYWORKER_LOCAL_LLM_URL=
PYWORKER_LOCAL_LLM_MODEL=

# Local form conversion uses PYWORKER_FORM_MODE=pipeline and defaults to Qwen3.5-27B.
# hybrid uses the same local document readers and calls EDENAI_LLM_MODEL with extracted blocks.
# Paths are relative to apps/pyworker when started with pnpm.
PYWORKER_PIPELINE_TIMEOUT_SECONDS=300
PYWORKER_PIPELINE_ASSETS=.models
PYWORKER_DOCUMENT_PYTHON=
PYWORKER_DOCUMENT_DEVICE=cpu
PYWORKER_DOC_CLASSPATH=
# Optional UTF-8 system prompt for form extraction. The default is bundled with Pyworker.
PYWORKER_PIPELINE_PROMPT_FILE=

# Optional read-only local EGiB SQLite file. See docs/0205-materialy-docx.pl.md.
PYWORKER_EGIB_SQLITE=
# Set PYWORKER_FORM_MODE=agentcore for per-page design after visual OCR.
PYWORKER_HARNESS_API_URL=
PYWORKER_HARNESS_API_KEY=

# Required fixed UTC deadline when agentcore mode is enabled.
PYWORKER_HARNESS_EXPIRES_AT=
