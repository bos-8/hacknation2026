      "legalRules": [
        {
          "id": "LP-001",
          "title": "Uprawnieni do wniosku o stwierdzenie nadpłaty",
          "basis": "Ordynacja podatkowa art.75 §2-2a (brzmienie po Dz.U.2026 poz.846)",
          "sources": [
            "AMEND846"
          ],
          "policy": "Rola podatnika, płatnika i inkasenta oraz szczególne przypadki wymagają odrębnej klasyfikacji. Płatnik/inkasent ma szczególne ograniczenie, a przypadki dawnych podmiotów dodatkowe warunki.",
          "action": "CONDITIONAL"
        },
        {
          "id": "LP-002",
          "title": "Rozdzielenie wniosku i korekty",
          "basis": "Dz.U. 2026 poz.846 art.1 pkt16, 22, 54: Ordynacja art.75, 81, 165 §8a",
          "sources": [
            "AMEND846"
          ],
          "policy": "Nie wymagać automatycznie korekty deklaracji jako załącznika do każdego wniosku; dla korekt dobrać właściwą ścieżkę.",
          "action": "REVIEW"
        },
        {
          "id": "LP-003",
          "title": "Uzasadnienie korekty deklaracji powyżej 10 000 zł",
          "basis": "Ordynacja podatkowa art.81 §2a-2b (po 2026-10-01)",
          "sources": [
            "AMEND846"
          ],
          "condition": {
            "op": "all",
            "args": [
              {
                "op": "eq",
                "field": "procedure_path",
                "value": "CORRECTION"
              },
              {
                "op": "gt",
                "field": "correction_overpayment_amount",
                "value": 10000
              }
            ]
          },
          "policy": "W ścieżce korekty pisemne uzasadnienie wymagane przy kwocie nadpłaty większej niż 10000 PLN.",
          "action": "CONDITIONAL"
        },
        {
          "id": "LP-004",
          "title": "Zaliczenie nadpłaty z urzędu",
          "basis": "Ordynacja podatkowa art.76 §1",
          "sources": [
            "ORD2026"
          ],
          "policy": "Preferencja użytkownika nie nadpisuje ustawowej kolejności rozliczenia.",
          "action": "AUTO"
        },
        {
          "id": "LP-005",
          "title": "Sposób zwrotu nadpłaty",
          "basis": "Ordynacja podatkowa art.77b §1",
          "sources": [
            "ORD2026"
          ],
          "policy": "Dostępne kanały zwrotu zależą od obowiązku posiadania rachunku i miejsca zamieszkania, więc rozszerzenie o kasę/przekaz wymaga profilu i weryfikacji.",
          "action": "REVIEW"
        },
        {
          "id": "LP-006",
          "title": "Pełnomocnik ogólny a deklaracja",
          "basis": "Ordynacja podatkowa art.138a i wyjaśnienia MF o PPO-1 i UPL-1",
          "sources": [
            "ORD2026",
            "MF_PROXY"
          ],
          "policy": "Pełnomocnik ogólny może składać pisma i wnioski; samo PPO-1 nie uprawnia do podpisywania deklaracji. Pełnomocnictwo wyłącznie do doręczeń nie upoważnia do złożenia wniosku.",
          "action": "CONDITIONAL"
        },
        {
          "id": "LP-007",
          "title": "Identyfikator podatkowy",
          "basis": "Ustawa o zasadach ewidencji i identyfikacji podatników i płatników art.3, objaśnienia MF",
          "sources": [
            "MF_TAXID"
          ],
          "policy": "Wybór identyfikatora na podstawie właściwego statusu podatkowego, a nie samego PERSON/ENTITY.",
          "action": "CONDITIONAL"
        },
        {
          "id": "LP-008",
          "title": "Zgoda RODO",
          "basis": "RODO art.6 i zasady UODO",
          "sources": [
            "UODO_CONSENT"
          ],
          "policy": "Nie tworzyć obowiązkowej zgody na przetwarzanie wymaganych danych, gdy istnieje inna podstawa prawna dla tego samego celu. Oddzielić obowiązek informacyjny.",
          "action": "REJECT"
        },
        {
          "id": "LP-009",
          "title": "Właściwość organu",
          "basis": "Dany typ podatku i reguły właściwości organów; dokument lokalny Ulan-Majorat",
          "sources": [
            "PDF_TAX"
          ],
          "policy": "Organ z papierowego wzoru jest wartością źródłową, nie uniwersalnym organem dla wszystkich podatków.",
          "action": "REVIEW"
        },
        {
          "id": "LP-010",
          "title": "Były wspólnik spółki cywilnej",
          "basis": "Art.75 §2 i art.81 §1a po zmianie z 2026 r.",
          "sources": [
            "AMEND846"
          ],
          "policy": "Odrębny profil obsługi umowy spółki aktualnej na dzień rozwiązania i ograniczeń wynikających z chwili złożenia korekty.",
          "action": "CONDITIONAL"
        },
        {
          "id": "LP-011",
          "title": "Podpis i pieczęcie",
          "basis": "Wymogi konkretnego kanału wniesienia i podpisywanego dokumentu",
          "sources": [
            "MF_PROXY"
          ],
          "policy": "Nie zastępować podpisu elektronicznego TEXT_FIELD, obrazem pieczątki ani napisem w TEXT_BLOCK.",
          "action": "REVIEW"
        }
      ],
