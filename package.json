{
  "name": "formiq",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal reusable PoC with Next.js, PostgreSQL, Keycloak and SeaweedFS.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "test:dev:infra:integration": "node tests/infra/dev-lifecycle.integration.mjs",
    "dev:infra:down": "node scripts/dev-infra.mjs down",
    "dev:infra:status": "node scripts/dev-infra.mjs status",
    "dev:infra:logs": "node scripts/dev-infra.mjs logs",
    "dev:doctor": "node --conditions=react-server scripts/dev-doctor.mjs",
    "dev:seed:users": "node scripts/dev-seed-users.mjs",
    "dev:prepare:application": "pnpm check:containers && pnpm check:dev-ports && pnpm preferences:sync && pnpm dev:build && pnpm dev:queue:prepare && pnpm dev:migrate && pnpm dev:seed && pnpm dev:seed:users",
    "qa:build:auth": "node scripts/qa.mjs build auth",
    "qa:build:s3": "node scripts/qa.mjs build s3",
    "qa:build:db": "node scripts/qa.mjs build db",
    "dev": "node scripts/dev.mjs",
    "dev:start:cold": "pnpm dev",
    "dev:start:warm": "pnpm dev",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:restart": "node scripts/dev.mjs restart",
    "dev:rebuild": "node scripts/dev.mjs rebuild",
    "dev:clean": "node scripts/dev.mjs clean",
    "dev:infra:delate": "pnpm dev:infra:delete",
    "dev:infra:delete": "node scripts/dev-infra.mjs delete",
    "dev:infra:up": "node scripts/dev-infra.mjs up",
    "dev:rebuild:web": "node scripts/dev.mjs rebuild web",
    "dev:rebuild:pyworker": "node scripts/dev.mjs rebuild pyworker",
    "dev:rebuild:prisma": "node scripts/dev.mjs rebuild prisma",
    "dev:rebuild:queue": "node scripts/dev.mjs rebuild queue",
    "dev:rebuild:monitoring": "node scripts/dev.mjs rebuild monitoring",
    "dev:rebuild:docker": "node scripts/dev.mjs rebuild docker",
    "dev.rebuild.web": "pnpm dev:rebuild:web",
    "dev.rebuild.pyworker": "pnpm dev:rebuild:pyworker",
    "dev.rebuild.prisma": "pnpm dev:rebuild:prisma",
    "dev.rebuild.queue": "pnpm dev:rebuild:queue",
    "dev.rebuild.monitoring": "pnpm dev:rebuild:monitoring",
    "dev.rebuild.docker": "pnpm dev:rebuild:docker",
    "dev:check:web": "pnpm --filter ./apps/web run typecheck && pnpm --filter ./apps/web run lint",
    "check:dev-auth": "node --conditions=react-server scripts/check-dev-auth.mjs",
    "dev:run": "pnpm terminal:clear && pnpm dev:prepare && pnpm terminal:clear && pnpm dev:services",
