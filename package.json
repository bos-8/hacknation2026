    "dev:migrate": "pnpm check:dev-databases && pnpm db:deploy",
    "dev:seed": "pnpm check:dev-databases && pnpm db:seed:prepared",
    "dev:services": "pnpm -r --parallel --stream --reporter=append-only --filter ./apps/web --filter ./apps/pyworker --filter ./packages/queue run dev",
    "dev:web": "pnpm --filter ./apps/web run dev",
    "dev:pythonworker": "pnpm dev:pyworker",
    "qa:init": "node scripts/qa.mjs init",
    "qa:check": "node scripts/qa.mjs check",
    "qa:build": "pnpm run \"/^qa:build:(web|pyworker|queue|maintenance|auth|s3|db)$/\"",
    "qa:build:web": "node scripts/qa.mjs build web",
    "qa:build:pyworker": "node scripts/qa.mjs build pyworker",
    "qa:build:queue": "node scripts/qa.mjs build queue",
    "qa:build:maintenance": "node scripts/qa.mjs build maintenance",
    "qa:build:keycloak": "node scripts/qa.mjs build keycloak",
    "qa:build:seaweedfs": "node scripts/qa.mjs build seaweedfs",
    "qa:build:postgres": "node scripts/qa.mjs build postgres",
    "qa:deploy": "node scripts/qa.mjs deploy",
    "qa:start": "node scripts/qa.mjs start",
    "qa:up": "pnpm qa:init && pnpm qa:check && pnpm qa:build && pnpm qa:deploy && pnpm qa:start",
    "qa:stop": "node scripts/qa.mjs stop",
    "qa:status": "node scripts/qa.mjs status",
    "qa:logs": "node scripts/qa.mjs logs",
    "test:qa:integration": "node tests/infra/qa.integration.mjs",
    "preferences:sync": "node scripts/sync-preference-assets.mjs",
    "preferences:check": "node scripts/sync-preference-assets.mjs --check",
    "dev:preflight": "pnpm validate:dev && pnpm check:dev-auth && pnpm validate:certs && pnpm check:docker",
    "build": "pnpm build:web",
    "build:web": "pnpm preferences:sync && pnpm build:database && pnpm build:queue && pnpm build:monitoring && pnpm --filter ./apps/web run build",
    "start": "pnpm start:web",
    "start:web": "node scripts/web.mjs start",
    "lint": "pnpm --filter ./apps/web run lint && pnpm lint:pyworker",
    "typecheck": "pnpm build:database && pnpm build:queue && pnpm build:monitoring && pnpm --filter @formiq/database run typecheck && pnpm --filter ./apps/web run typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "pnpm test:scripts && pnpm test:database && pnpm test:web && node --test tests/queue/backoff*.test.mjs tests/monitoring/*.test.mjs && pnpm test:pyworker",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:web": "pnpm build:queue && pnpm build:monitoring && pnpm --filter ./apps/web run test",
    "test:queue:backoff": "pnpm build:queue && node --test tests/queue/backoff*.test.mjs",
    "test:ui": "node --test tests/web/basic-ui.test.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:dry": "node scripts/clean.mjs --dry-run",
    "validate:env": "node scripts/validate-env.mjs",
    "env:example:copy": "node scripts/copy-env-examples.mjs",
    "validate:dev": "node scripts/validate-env.mjs --mode dev",
    "validate:qa": "node scripts/validate-env.mjs --mode qa --require-values",
    "validate:prod": "node scripts/validate-env.mjs --mode prod --require-values",
    "validate:certs": "node scripts/validate-certs.mjs",
    "check:ports": "node scripts/check-ports.mjs",
    "check:dev-ports": "node scripts/check-ports.mjs --dev",
    "check:docker": "node scripts/check-docker.mjs engine",
    "check:containers": "node scripts/check-docker.mjs containers",
    "check:dev-databases": "node scripts/check-dev-databases.mjs",
    "stack:init": "node scripts/stack.mjs init",
    "stack:up": "node scripts/stack.mjs up",
    "stack:down": "node scripts/stack.mjs down",
    "stack:ps": "node scripts/stack.mjs ps",
    "stack:logs": "node scripts/stack.mjs logs",
    "stack:config": "node scripts/stack.mjs config",
    "stack:pull": "node scripts/stack.mjs pull",
    "stack:auth:sync": "node scripts/stack.mjs auth:sync",
    "build:database": "pnpm --filter @formiq/database run build",
    "db:generate": "pnpm --filter @formiq/database run db:generate",
    "db:validate": "pnpm --filter @formiq/database run db:validate",
    "db:format": "pnpm --filter @formiq/database run db:format",
    "db:migrate": "pnpm --filter @formiq/database run db:migrate",
    "db:deploy": "pnpm --filter @formiq/database run db:deploy",
    "db:status": "pnpm --filter @formiq/database run db:status",
    "db:seed": "pnpm --filter @formiq/database run db:seed",
    "db:seed:prepared": "pnpm --filter @formiq/database run db:seed:prepared",
    "db:studio": "pnpm --filter @formiq/database run db:studio",
    "db:migrate:create": "pnpm db:migrate --create-only",
    "test:database": "pnpm build:database && node --test tests/database/*.test.mjs",
    "test:database:integration": "pnpm build:database && node tests/database/seed.integration.mjs",
    "test:products:integration": "pnpm build:database && node tests/database/products.integration.mjs",
    "test:tags:integration": "pnpm build:database && node tests/database/tags.integration.mjs",
    "test:queue:integration": "pnpm build:queue && node tests/queue/queue.integration.mjs",
    "test:auth:integration": "pnpm build:database && node --conditions=react-server tests/web/auth.integration.mjs",
    "test:infra": "node tests/infra/compose-bootstrap.integration.mjs",
    "build:queue": "pnpm --filter @formiq/queue run build",
    "queue:setup": "pnpm build:queue && node scripts/queue-setup.mjs",
    "queue:worker": "pnpm build:database && pnpm build:queue && pnpm build:monitoring && node scripts/worker.mjs",
    "dev:queue": "pnpm --filter ./packages/queue run dev",
    "build:monitoring": "pnpm --filter @formiq/monitoring run build",
    "test:monitoring": "pnpm build:database && pnpm build:monitoring && node --test tests/monitoring/*.test.mjs",
    "test:monitoring:integration": "pnpm build:database && pnpm build:monitoring && node tests/monitoring/health.integration.mjs",
    "test:config:integration": "pnpm build:database && pnpm build:monitoring && node tests/database/system-config.integration.mjs",
    "test:llm-settings:integration": "pnpm build:database && node tests/database/llm-settings.integration.mjs",
    "test:queue:actions": "pnpm build:queue && node tests/queue/actions.integration.mjs",
    "pyworker:setup": "node scripts/pyworker.mjs setup",
    "pyworker:prepare": "node scripts/pyworker.mjs prepare",
    "dev:pyworker": "pnpm --filter ./apps/pyworker run dev",
    "start:pyworker": "node scripts/pyworker.mjs start",
    "test:pyworker": "node scripts/pyworker.mjs test",
    "lint:pyworker": "node scripts/pyworker.mjs lint",
    "test:pyworker:integration": "pnpm build:queue && pnpm test:pyworker:bridge && node scripts/pyworker.mjs test && node tests/queue/python.integration.mjs",
    "test:pyworker:bridge": "node tests/pyworker/bridge.integration.mjs",
    "test:pyworker:reload": "node tests/pyworker/reload.integration.mjs",
    "s3console:init": "node scripts/s3console.mjs init",
    "s3console:build": "node scripts/s3console.mjs build",
    "s3console:start": "node scripts/s3console.mjs start",
    "s3console:up": "node scripts/s3console.mjs up",
    "s3console:stop": "node scripts/s3console.mjs stop",
    "s3console:status": "node scripts/s3console.mjs status",
    "s3console:logs": "node scripts/s3console.mjs logs",
    "test:s3console:integration": "node tests/infra/s3console.integration.mjs",
    "storage:report": "pnpm build:database && node scripts/storage-reconcile.mjs report",
    "storage:cleanup": "node scripts/storage-reconcile.mjs cleanup",
    "test:storage:conditional-delete": "node tests/storage/conditional-delete.integration.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:restore": "node scripts/backup.mjs restore",
    "test:reliability": "pnpm build:database && pnpm build:monitoring && node --conditions=react-server --test tests/web/logout-race.test.mjs tests/monitoring/deadline.test.mjs tests/scripts/child-process.test.mjs tests/scripts/storage-reconciliation.test.mjs tests/scripts/volume-backup.test.mjs",
    "test:pyworker:shutdown": "node tests/pyworker/shutdown.integration.mjs",
    "test:browser:reliability": "node tests/browser/reliability.integration.mjs",
    "test:backup:integration": "node tests/infra/compose-bootstrap.integration.mjs --backup",
    "test:queue:recovery": "pnpm build:queue && node tests/queue/recovery.integration.mjs"
  },
  "dependencies": {
    "undici": "8.12.4"
  }
}
